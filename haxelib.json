{
  "name": "hxn-window",
  "version": "0.2.0",
  "description": "Windowing and surfaces for Haxe: windows, input, monitors and native handles for rendering",
  "url": "https://github.com/hx-n/hxn-window",
  "license": "Apache",
  "tags": [
    "window",
    "input",
    "haxe",
    "hashlink",
    "hxcpp",
    "cppia",
    "monitors",
    "gamepads",
    "native",
    "surface",
    "rendering",
    "cross",
    "wasm"
  ],
  "contributors": [
    "darmie",
    "rayzor"
  ],
  "releasenote": "Moves to the hxn.window package, on hxn 0.3.5.",
  "dependencies": {
    "hxn": "0.3.6"
  },
  "hxn": {
    "cli": {
      "version": 1,
      "namespace": "window",
      "command": [
        "haxe",
        "-cp",
        "{root}/sources",
        "--run",
        "hxn.window.cli.Tool"
      ],
      "hooks": [
        "before-build",
        "before-check"
      ]
    }
  }
}
